# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Dependencies
**/node_modules/
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/sdks/
!**/.yarn/versions/

# Logs and runtime output
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/logs/
**/pids/
**/*.pid
**/*.pid.lock

# Expo, Metro, and React Native caches
**/.expo/
**/.expo-shared/
**/.metro-health-check*
**/.parcel-cache/
**/.cache/
**/.npm/
**/.eslintcache
**/*.tsbuildinfo

# Build and generated output
**/dist/
**/build/
**/web-build/
**/.expo-smoke-export/
**/coverage/
**/.next/
**/out/
**/android/.gradle/
**/android/app/build/
**/ios/build/

# Native signing material
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.pem

# OS and editor files
.DS_Store
Thumbs.db
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
*.swp

# Unrelated Black JavaScript library artifacts bundled in the frontend folder
SKILLIFY-Frontend-main/docs/*
!SKILLIFY-Frontend-main/docs/content/
!SKILLIFY-Frontend-main/docs/content/licence.html
SKILLIFY-Frontend-main/docs/content/*
!SKILLIFY-Frontend-main/docs/content/licence.html
